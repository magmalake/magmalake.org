# Short links to the org issue tracker, which lives in the .github repo.
# 302, not 301: if issues ever move repo, a cached permanent redirect would
# outlive the decision.
/issues/*  https://github.com/magmalake/.github/issues/:splat  302
/issues    https://github.com/magmalake/.github/issues         302

# Pages folded into the per-tin pages at /s/<tin>: each tin's correctness
# evidence and status now live on its own page, reached from /tins.
/correctness  /tins  302
/status       /tins  302

# Orca and Dista moved out of magmalake: they are Morca now, with its own site,
# and the pages keep their names there. Orca's docs are under /docs (its API
# reference is /docs/api); Dista's are under /dista. Morca's code and docs
# still link to mlake.dev/s/orca/docs. 301: the move is permanent.
#
# Keep the rules from overlapping. In production a catch-all /s/orca/* beat
# the more specific rules above it and sent every Orca URL to morca.dev's home
# page, though wrangler dev honoured the order. Orca only had /s/orca, its
# docs and its API, so there is no catch-all.
/s/orca/roadmap      https://morca.dev/docs/roadmap/      301
/s/orca/roadmap/     https://morca.dev/docs/roadmap/      301
/s/orca/docs         https://morca.dev/docs/              301
/s/orca/docs/        https://morca.dev/docs/              301
/s/orca/docs.md      https://morca.dev/docs.md            301
/s/orca/docs/*       https://morca.dev/docs/:splat        301
/s/orca/api          https://morca.dev/docs/api/          301
/s/orca/api/         https://morca.dev/docs/api/          301
/s/orca/api.md       https://morca.dev/docs/api.md        301
/s/orca/api/*        https://morca.dev/docs/api/:splat    301
/s/orca.md           https://morca.dev/index.md           301
/s/orca              https://morca.dev/                   301
/s/orca/             https://morca.dev/                   301

/s/dista.md          https://morca.dev/dista/index.md     301
/s/dista             https://morca.dev/dista/             301
/s/dista/            https://morca.dev/dista/             301
/s/dista/*           https://morca.dev/dista/:splat       301

