{
  // Cloudflare Workers static assets, plus one small Worker for `/ph/*`.
  // `assets.run_worker_first` routes only that path to `main`; every other
  // request is still served straight from the uploaded `dist/` with no
  // Worker invocation and no per-request cost.
  //
  //   npm run build          -> produces ./dist
  //   npx wrangler deploy    -> uploads ./dist and worker/posthog-proxy.js
  //
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magmalake-org",
  "compatibility_date": "2026-08-31",
  "main": "worker/posthog-proxy.js",
  // These domains are registered in this Cloudflare account; wrangler creates
  // and manages the DNS record for a custom domain itself, so a domain that is
  // missing here has no DNS at all, not merely no route.
  //
  // mlake.dev serves the same site rather than redirecting to it. Canonical
  // links and the sitemap come from `site` in astro.config.mjs and still say
  // magmalake.org, which is what consolidates the two for search.
  "routes": [
    { "pattern": "magmalake.org", "custom_domain": true },
    { "pattern": "www.magmalake.org", "custom_domain": true },
    { "pattern": "mlake.dev", "custom_domain": true },
    { "pattern": "www.mlake.dev", "custom_domain": true },
    { "pattern": "magmalake.dev", "custom_domain": true },
    { "pattern": "www.magmalake.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Astro emits directory-style pages; serve /path and /path/ alike.
    "html_handling": "auto-trailing-slash",
    // Static site with a real 404 page, not an SPA.
    "not_found_handling": "404-page",
    // Only the PostHog proxy path invokes the Worker; everything else is
    // served straight from assets (see worker/posthog-proxy.js).
    "run_worker_first": ["/ph/*"]
  },
  "observability": {
    "enabled": true
  }
}
