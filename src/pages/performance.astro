---
import Base from "../layouts/Base.astro";
import PerfTable from "../components/PerfTable.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { tins, slugOf, pageOf } from "../data/tins";
import {
  highlights,
  perfFor,
  perfIntro,
  perfMethod,
  perfHistory,
  perfReproduce,
} from "../data/perf";

const description =
  "The strongest magmalake benchmarks against pyarrow and other references, including where it loses, with links to each tin's full numbers and to Dista's.";

// Every tin with numbers of its own, in the stack's order; Dista's are on its own pages.
const measured = tins.filter((t) => !t.site && perfFor(slugOf(t)).length > 0);
---

<Base title="Performance" description={description}>
  <section class="section">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Performance</p>
      <h1 class="section-title">Measured, including where it loses</h1>
      {perfIntro.map((p) => <p class="lede">{p}</p>)}

      <div class="perf-groups">
        <PerfTable group={highlights} tinLinks />
      </div>

      <div class="panel perf-panel" id="by-tin">
        <h2 class="panel__title">Each tin's numbers</h2>
        <ul class="bench-links">
          {measured.map((t) => <li><a href={`${pageOf(t)}#performance`}><code>{t.name}</code></a></li>)}
          <li><a href="/s/dista/performance"><code>Dista</code></a></li>
        </ul>
        <p class="panel__fine">
          Crossing a process boundary — Arrow Flight, the C Data Interface and shared memory —
          is on the <a href="/s/memory-region#perf-boundary">memory-region</a> page.
        </p>
      </div>

      <div class="panel perf-panel" id="method">
        <h2 class="panel__title">
          <a class="perf__anchor" href="#method">How these were measured</a>
        </h2>
        {perfMethod.map((p) => <p set:html={p} />)}
      </div>

      <div class="panel perf-panel" id="benchmarks">
        <h2 class="panel__title">
          <a class="perf__anchor" href="#benchmarks">Benchmark history</a>
        </h2>
        <p set:html={perfHistory.before} />
        <ul class="bench-links">
          {
            tins.filter((t) => t.benchmarks).map((t) => (
              <li><a href={t.benchmarks} rel="noopener"><code>{t.name}</code></a></li>
            ))
          }
        </ul>
        <p set:html={perfHistory.after} />
      </div>

      <div class="panel perf-panel" id="perf-reproduce">
        <h2 class="panel__title">
          <a class="perf__anchor" href="#perf-reproduce">Reproducing any of this</a>
        </h2>
        <p set:html={perfReproduce.before} />
        <CodeBlock code={perfReproduce.commands} label="shell" />
        {perfReproduce.after.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .perf-groups { margin-top: 2.5rem; }

  .perf-panel {
    margin-top: 2rem;
    scroll-margin-top: 5rem;
  }

  .bench-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .bench-links code { font-size: 0.85rem; }
</style>
