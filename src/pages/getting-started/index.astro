---
import "../../styles/getting-started.css";
import Base from "../../layouts/Base.astro";
import PipelineDiagram from "../../components/PipelineDiagram.astro";
import { GHARCHIVE_REPO, LIBS, ORCA_DEMO } from "../../data/gharchive";

const description =
  "Build a lake of GitHub activity on magmalake: see it running, then build it by handing a coding agent the skills and a prompt, or step by step from pixi and mojoshelf to Orca pipelines, a flare console, a local run and a deploy to AWS.";

const host = (u: string) => u.replace(/^https:\/\//, "");
---

<Base title="Getting started" description={description}>
  <section class="section section--flush">
    <div class="wrap wrap--wide docs gs">
      <p class="eyebrow">Getting started</p>
      <h1 class="section-title">A lake of GitHub activity</h1>
      <p class="lede">
        The example is <a href={GHARCHIVE_REPO} rel="noopener">gharchive.example</a>: it
        imports every day of the <a href="https://www.gharchive.org/" rel="noopener">GH Archive</a>
        into an Iceberg table, finds the Mojo repositories in it, reads each one's git history,
        and serves a web console that shows how Mojo libraries have grown. Everything in it is
        Mojo, in one pixi project. An agent built it from a prompt, with only the skills as
        documentation.
      </p>

      <h2 id="live">See it running</h2>
      <p>The example runs on AWS, deployed with <code>orca aws</code>. Both sites are public to read.</p>
      <div class="gs-cards">
        <a class="gs-card" href={ORCA_DEMO} rel="noopener">
          <span class="gs-card__title">Orca's UI</span>
          <span class="gs-card__host">{host(ORCA_DEMO)}</span>
          <span class="gs-card__text">
            The three pipelines, their runs and logs, the Dista timeline of a run's tasks, the
            lineage of each table, and links to the code that made them.
          </span>
        </a>
        <a class="gs-card" href={LIBS} rel="noopener">
          <span class="gs-card__title">The console</span>
          <span class="gs-card__host">{host(LIBS)}</span>
          <span class="gs-card__text">
            How Mojo libraries grew: their size and age, the Mojo versions and tooling they
            moved to over time, and a page per repository.
          </span>
        </a>
      </div>

      <h2 id="pipelines">How it fits together</h2>
      <p>
        Three Orca pipelines write five Iceberg tables. gharchive runs on a schedule; each
        day it commits starts mojo_repos, and each batch of new repositories starts
        mojo_history. The console reads the last three tables.
      </p>
      <PipelineDiagram />

      <h2 id="choose">Build it yourself</h2>
      <p>Two ways, one project. Each page stands on its own.</p>
      <div class="gs-cards">
        <a class="gs-card" href="/getting-started/agent">
          <span class="gs-card__title">Let an agent build it</span>
          <span class="gs-card__text">
            Install the skills for Mojo, magmalake, mojoshelf and AWS, then give a coding agent
            the prompt that built gharchive.example.
          </span>
        </a>
        <a class="gs-card" href="/getting-started/step-by-step">
          <span class="gs-card__title">Step by step</span>
          <span class="gs-card__text">
            Install pixi and mojoshelf, create the project, read the code the agent wrote, run
            it locally, and deploy it to AWS. Or clone the example and run it as it is.
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

{/* The sections used to be on this one page; send their old anchors to the
    page they moved to. */}
<script is:inline>
  (function () {
    var agent = { agent: "", skills: "skills", prompt: "prompt" };
    var steps = { steps: "", tools: "tools", project: "project", code: "code", local: "local", aws: "aws" };
    var h = location.hash.slice(1);
    if (h in agent) location.replace("/getting-started/agent" + (agent[h] ? "#" + agent[h] : ""));
    else if (h in steps) location.replace("/getting-started/step-by-step" + (steps[h] ? "#" + steps[h] : ""));
  })();
</script>
