    height: auto;
    display: block;
    --wd-line: var(--text-muted);
    font-family: var(--font-body);
  }
  .wdiagram :global(.wd-box) {
    fill: var(--bg-alt);
    stroke: var(--border-strong);
  }
  .wdiagram :global(.wd-node) {
    fill: var(--surface);
    stroke: var(--border-strong);
  }
  .wdiagram :global(.wd-line) {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .wdiagram :global(.wd-https) {
    stroke: var(--lake);
    stroke-width: 2;
  }
  .wdiagram :global(.wd-head) {
    fill: var(--text-muted);
  }
  .wdiagram :global(.wd-txt),
  .wdiagram :global(.wd-cap),
  .wdiagram :global(.wd-sub) {
    text-anchor: middle;
    fill: var(--text);
    font-size: 13px;
  }
  .wdiagram :global(.wd-cap) {
    text-anchor: start;
    fill: var(--text-muted);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .wdiagram :global(.wd-sub) {
    fill: var(--text-muted);
    font-size: 12px;
  }
  figcaption {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
</style>
