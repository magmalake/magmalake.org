---
import OrcaDocs from "../../../../components/OrcaDocs.astro";
import CodeBlock from "../../../../components/CodeBlock.astro";
import { ORCA_PRS, ORCA_REPO } from "../../../../data/orca";

const DOCS = `${ORCA_REPO}/blob/main/docs`;

const description =
  "Scheduling and running Orca pipelines: the scheduler and its fires, retries and limits, runs on this machine, on Kubernetes or on EC2, remote workers and fills, runs sized by memory and CPU, held off by memory pressure and contained in cgroups, runs recorded and resumed in Postgres, deploys and rollbacks, logs and machine metrics, lineage and rebuilds, every environment variable, and what happens when things fail.";

const env = [
  ["ORCA_DATABASE_URL", "the Postgres database runs are recorded in, or a SQLite file (sqlite:<path>) for one machine; unset, a pipeline's run runs in memory", "unset"],
  ["ORCA_STALE_SECONDS", "how old a run's heartbeat must be before another process may resume it", "30"],
  ["ORCA_WORKERS", "the local Dista workers a run forks", "4"],
  ["ORCA_LOGS", "where attempts' logs, timelines, driver logs, instance logs and metrics go: a directory or s3://bucket/prefix", "unset"],
  ["ORCA_LOG_STAGE", "where a log bound for object storage is written until it's complete", "$TMPDIR/orca-logs"],
  ["ORCA_WAREHOUSE", "the root of the filesystem catalog datasets are found in, a directory or s3://; ns.table is <warehouse>/ns/table", "unset"],
  ["ORCA_CANCEL_KILL_SECONDS", "how long a cancelled run's running step has to finish before it's stopped", "60"],
  ["ORCA_RETRY_SECONDS", "the scheduler's first wait before retrying a failed run, doubled with each start", "60"],
  ["ORCA_SENSE_SECONDS", "how often the scheduler asks a sensor's binary for its datasets' current snapshots", "60"],
  ["ORCA_SAMPLE_SECONDS", "how often a run's sampler writes a line of machine metrics; 0 turns it off", "5"],
  ["ORCA_RUNNER", "where the scheduler starts runs: local, kubernetes or ec2", "local"],
  ["ORCA_CONFIG", "the orca.toml orca register reads, unless --config names another", "./orca.toml"],
  ["ORCA_PIPELINES_DIR", "where orca register with no paths finds each [pipelines.<name>] binary", "pipelines/ next to the file"],
  ["ORCA_CONTROL_MAX_RUNS, ORCA_CONTROL_MEMORY_MB, ORCA_CONTROL_NICE, ORCA_CONTROL_WORKERS", "the limits of control-placed runs: at once, resident memory, nice and local Dista workers", "2, 1024, 10, 1"],
  ["ORCA_HOST_CPUS, ORCA_HOST_MEMORY_MB", "what this host can grant, over what orca reads from its cgroup or the machine", "the host's"],
  ["ORCA_RESERVE_CPUS, ORCA_RESERVE_MEMORY_MB", "kept back from grants for the scheduler, Postgres and the UI; on a worker, for the worker", "1, 1536 (a worker: 0, 512)"],
  ["ORCA_ADMIT_MEMORY_PRESSURE", "the PSI some avg10 percent over which no new run starts; 0 turns it off", "10"],
  ["ORCA_ADMIT_PRESSURE_GRACE_SECONDS", "how long a pressure hold lasts with none of orca's runs going before runs start one at a time", "600"],
  ["ORCA_MEMORY_PRESSURE_FILE", "the PSI file to read instead of the one orca finds; every run gets the one its host's pressure is read from", "found"],
  ["ORCA_CGROUPS", "0 turns off a cgroup per run", "on where orca can make them"],
  ["ORCA_RUN_MEMORY_MB", "the memory limit of a run without a request or grant", "what the host can grant"],
  ["ORCA_RUN_MEMORY_MARGIN", "the percent over its limit at which the kernel kills a run", "25"],
  ["ORCA_RUN_MEMORY_GROWTH", "how much more a run killed for its memory asks for next time", "1.5"],
  ["ORCA_WATCHDOG_SECONDS", "how often the watchdog checks its rules; 0 turns it off. Each threshold has an ORCA_WATCHDOG_* variable of its own", "60"],
  ["ORCA_NOTIFY_URL", "an ntfy topic URL alerts are pushed to; ORCA_NOTIFY_SECRET reads the topic from a secret instead", "unset: no alerts"],
  ["ORCA_FIXED_COST", "on the local runner, what Ops › Pools' Cost tile shows, such as €8.49/month", "unset"],
  ["ORCA_WORKER_TOKEN", "a remote worker's token, from orca worker-token create", "unset"],
  ["ORCA_VCPU_BUDGET", "the vCPUs all live runs' pods or instances may use together; a run that would go over waits", "no limit"],
  ["ORCA_RUN_ENV", "the scheduler's variables, by name and comma-separated, copied to every run's pods or instances", "unset"],
  ["ORCA_RUN_DEADLINE", "seconds after which a run's pods or instances are removed whatever their state", "86400"],
  ["ORCA_IMAGE", "the image a run's binary is in, recorded with its version; the runners set it", "unset"],
  ["ORCA_EC2_HEAD_TYPE", "the head instance's type, unless registration gave one", "c7g.large"],
  ["ORCA_EC2_WORKER_TYPE", "the worker instances' type, unless registration gave one", "c7g.xlarge"],
  ["ORCA_EC2_AMI", "the image run instances boot", "unset"],
  ["ORCA_EC2_SUBNET, ORCA_EC2_SECURITY_GROUP, ORCA_EC2_PROFILE", "where run instances go, their security group, and their instance profile", "unset"],
  ["ORCA_EC2_DATABASE_URL", "the database URL run instances use, such as the control instance's private address", "ORCA_DATABASE_URL"],
  ["ORCA_EC2_PREAMBLE", "shell run on each instance before the pipeline, such as an ECR login", "unset"],
  ["ORCA_EC2_MODE", "docker runs the image on the instance; direct runs the binary, for the tests' stand-in EC2", "docker"],
  ["ORCA_CLUSTER_LOG_SECONDS", "how often a run instance uploads its head's or worker's log", "30"],
  ["ORCA_RUNS_NAMESPACE", "the Kubernetes namespace runs' pods go in", "orca-runs"],
  ["ORCA_UI_ADDR", "host:port orca ui listens on", "127.0.0.1:8270"],
  ["ORCA_WORKER_ADDR", "a host:port where orca ui also serves the worker API, from a thread of its own (since 0.15.0)", "unset: the UI's port only"],
  ["ORCA_UI_LOGIN", "required makes the UI's actions need a login even before any user exists", "on once a user exists"],
  ["ORCA_UI_SESSION_HOURS", "how long a login lasts", "12"],
  ["ORCA_UI_SECURE_COOKIES", "1 marks the session cookie Secure, for a UI behind HTTPS", "unset"],
  ["ORCA_UI_TRUST_PROXY", "1 takes a request's address from X-Forwarded-For, behind a proxy you run", "unset"],
  ["ORCA_UI_URL", "the UI's public address, for the Open in Perfetto link and the alerts' links", "unset"],
  ["ORCA_DOCS_URL", "where the UI's Docs links point", "https://mlake.dev/s/orca/docs/"],
  ["ORCA_NOW", "fixes the clock of fires and the scheduler, as 2024-03-10T07:00Z or epoch seconds, for tests", "the clock"],
  ["ORCA_ZONEINFO", "where time zones' TZif files are read from", "/usr/share/zoneinfo"],
  ["DISTA_ROLE", "head or worker: the binary runs as that Dista process instead", "unset"],
  ["DISTA_HEAD", "host:port of a Dista head to join instead of forking workers", "local mode"],
];
---

<OrcaDocs href="/s/orca/docs/run" description={description}>
  <p class="eyebrow">Docs</p>
  <h1 class="section-title">Scheduling and running</h1>
  <p class="lede">
    The scheduler starts runs when they're due, retries the ones that fail, and starts
    each on this machine or on a cluster of its own. Every run is recorded in Postgres,
    so any of them can be resumed, and its tables say what made them.
  </p>

  <nav class="docs-toc" aria-label="On this page">
    <a href="#scheduler">The scheduler</a>
    <a href="#runners">On Kubernetes and EC2</a>
    <a href="#placement">Placement and remote workers</a>
    <a href="#fills">Fills</a>
    <a href="#resources">Memory and CPU</a>
    <a href="#watchdog">The watchdog</a>
    <a href="#alerts">Alerts</a>
    <a href="#state">Runs in Postgres</a>
    <a href="#deploys">Deploys and rollbacks</a>
    <a href="#logs">Logs</a>
    <a href="#metrics">Machine metrics</a>
    <a href="#lineage">Lineage</a>
    <a href="#rebuilds">Rebuilds</a>
    <a href="#env">Environment</a>
    <a href="#failures">When things fail</a>
  </nav>

  <h2 id="scheduler">The scheduler</h2>
  <p>
    <code>orca scheduler</code> links no pipeline. It knows one by the
    <code>describe</code> that <code>orca register</code> recorded, and starts its runs as
    <code>&lt;binary&gt; resume &lt;run&gt;</code>, so a run records its own progress
    exactly as a run started by hand does. It needs <code>ORCA_DATABASE_URL</code>;
    <a href="/s/orca/docs/cli#orca">the command line</a> lists its commands.
  </p>
  <CodeBlock label="shell" code={`./build/orca register ./build/gharchive
./build/orca backfill gharchive 2025-01-01..2025-01-31
./build/orca scheduler`} />
  <p>
    Each fire is a row with a unique (pipeline, time), inserted with its queued run in one
    transaction, so two schedulers ticking at once, or one killed mid-tick, never fire
    twice. Fires missed while it was down are made on its next tick, once each. A queued
    run starts only while fewer than <code>max_runs</code> of the pipeline's runs are live,
    counted under a lock on the pipeline's row, and none start while it's paused. A
    scheduled, backfilled or sensed run that fails is started again after
    <code>ORCA_RETRY_SECONDS</code>, doubled with each start, plus up to a tenth as jitter,
    up to <code>run_retries</code> times; one whose process died is started again as soon
    as its heartbeat is stale. A run you started by hand, or from the UI, isn't retried.
    The scheduler holds nothing in memory, so it can be stopped and restarted at any time.
    Registering a new build moves the pipeline's queued runs to the new code.
  </p>

  <h2 id="runners">On Kubernetes and EC2</h2>
  <p>
    By default the scheduler starts a run as a process on its own machine, and the run
    forks its Dista workers there. <code>ORCA_RUNNER</code> starts each run on a
    cluster of its own instead, from the image the pipeline was registered with:
  </p>
  <CodeBlock label="shell" code={`./build/orca register \\
    --image 123456789012.dkr.ecr.us-east-2.amazonaws.com/orca:data \\
    --head-type c7g.large --worker-type c7g.2xlarge \\
    --workers 3 ./build/taxi
ORCA_RUNNER=ec2 ./build/orca scheduler`} />
  <p>
    <strong><code>ORCA_RUNNER=ec2</code></strong> starts a head instance, on demand,
    running the Dista head and the driver (<code>&lt;binary&gt; resume &lt;run&gt;</code>),
    and <code>--workers</code> worker instances pointed at it; <code>--spot</code> makes
    the workers Spot instances, where the account allows them, and
    <code>--workers MIN..MAX</code> starts <code>MIN</code> and adds or drains workers up
    to <code>MAX</code> as the head's demand changes. Each instance is tagged with its
    run, told to terminate when it shuts down, and recorded with its type, when it
    started and ended, and why it ended (it shut itself down, it was terminated, or a
    Spot interruption). <strong><code>ORCA_RUNNER=kubernetes</code></strong> creates a
    driver Job, a head Pod and Service and the worker Pods in
    <code>ORCA_RUNS_NAMESPACE</code>, all labelled with the run and owned by the Job.
    A pipeline without Dista tasks gets only its driver.
  </p>
  <p>
    Both clean up in layers. A run's instances or pods end when it does; every tick the
    scheduler removes those of runs that aren't running any more and those older than
    <code>ORCA_RUN_DEADLINE</code>, so nothing a killed scheduler left behind keeps
    running. A run whose head goes is started again on new instances. Before making a
    cluster, the scheduler adds up the vCPUs of every live run's pods or instances, and
    a run that would take them past <code>ORCA_VCPU_BUDGET</code> waits.
  </p>
  <p>
    <code>orca aws up</code> makes all of this on AWS as one stack: a control instance
    running the scheduler with <code>ORCA_RUNNER=ec2</code>, Postgres and the UI, and
    what run instances need (<a href="/s/orca/docs/cli#aws">orca aws</a>,
    <a href="/s/orca/docs/cli#where">local or AWS?</a>).
  </p>

  <h2 id="placement">Placement and remote workers</h2>
  <p>
    A pipeline's placement says which machine starts its runs:
    <code>default</code>, the scheduler's runner; <code>ec2</code>, instances of their
    own; <code>control</code>, child processes of the scheduler on its own host, for
    small runs that shouldn't wait for an instance, within memory, CPU and count limits;
    or <code>worker:&lt;pool&gt;</code>, a remote worker of that pool. Set it in
    <code>orca.toml</code> (<code>placement = "control"</code>) or with
    <code>orca register --placement</code>
    (<a href={`${DOCS}/placement.md`} rel="noopener">placement.md</a>).
  </p>
  <p>
    A remote worker, such as a machine with spare CPU, runs
    <code>orca worker --pool &lt;pool&gt; --remote &lt;url&gt;</code>. It claims its
    pool's runs from <code>orca ui</code> over HTTPS and runs them on its own machine;
    each run records its state through the UI's API instead of Postgres, so nothing on
    the worker holds database credentials. Its token, from
    <code>orca worker-token create --pool &lt;pool&gt;</code>, is scoped to the pool and
    revocable. Since 0.15.0 a run whose worker is gone is queued again for the pool,
    whatever started it, within <code>run_retries</code> starts
    (<a href="/s/orca/docs/workers">Remote workers</a>,
    <a href={`${DOCS}/workers.md`} rel="noopener">workers.md</a>).
  </p>
  <CodeBlock label="shell" code={`./build/orca register --placement worker:bgent ./build/toy
./build/orca worker-token create --pool bgent        # on the server
ORCA_WORKER_TOKEN=orca_... ./build/orca worker --pool bgent --remote https://orca.example.com`} />

  <h2 id="fills">Fills</h2>
  <p>
    With <code>fills = "all"</code> in <code>orca.toml</code>, the scheduler fills a
    pipeline's whole range by itself, one partition a run, in <code>fill_order</code>,
    with at most <code>fill_max_runs</code> at once, within an estimated
    <code>fill_budget_per_day</code> and in the UTC hours of <code>fill_window</code>. It
    never reruns a done partition and stops while the pipeline is paused. The pipeline
    page's Progress card shows done of total, rate, ETA and why a fill is idle
    (<a href={`${DOCS}/orca-toml.md#fills`} rel="noopener">orca-toml.md#fills</a>).
    Since 0.15.0 a pipeline placed on a worker pool fills too: its fill runs are queued
    in the same order and window for the pool's workers to claim, with at most
    <code>fill_max_runs</code> across the whole pool.
  </p>

  <h2 id="resources">Memory and CPU</h2>
  <p>
    The scheduler measures every run it starts on its own host, and
    <code>orca worker</code> every run it starts: each attempt's peak memory, CPU time
    and peak cores, shown on the run, its steps and the pipeline's Resources card
    (since 0.14.0). Runs on EC2 and Kubernetes aren't measured this way; their machines
    are, under Machines. A pipeline can then ask for what it needs, in
    <code>orca.toml</code> or with <code>orca register --cpus</code> and
    <code>--memory-gb</code>, as the least it needs to start and the most it can use:
  </p>
  <CodeBlock label="orca.toml" code={`[pipelines.gharchive]
cpus = "1..16"
memory_gb = "2..24"
env = { DISTA_WORKER_SLOTS = "auto", GHARCHIVE_PARALLEL = "auto" }`} />
  <p>
    <strong>Grants</strong> (since 0.14.0). On the local runner, for control-placed runs
    and on a remote worker, a run starts only if its minimum fits what the host can grant
    (its CPUs and memory less a reserve, <code>ORCA_RESERVE_CPUS</code> and
    <code>ORCA_RESERVE_MEMORY_MB</code>) less what the runs going there were granted;
    otherwise it waits, saying why (<code>waiting: needs 2 GB, 1.3 GB free of
    grants</code>). A run that starts gets up to its maximum of what's left, fixed for that
    start, in <code>ORCA_GRANT_CPUS</code> and <code>ORCA_GRANT_MEMORY_MB</code>. An
    <code>env</code> value <code>"auto"</code> lets the run size itself from the grant
    (<code>orca.auto_count</code>; <code>DISTA_WORKER_SLOTS</code> becomes the granted
    CPUs over the run's local workers). A pipeline without a request runs as before, and
    on EC2 and Kubernetes the request is kept but not used yet.
  </p>
  <p>
    <strong>Memory pressure</strong> (since 0.15.0). Requests are estimates, so on the
    local runner, the control host and each worker no new run starts while Linux's
    pressure stall information reads <code>some avg10</code> over
    <code>ORCA_ADMIT_MEMORY_PRESSURE</code> (10%); runs already going go on. A waiting run
    says <code>waiting: memory pressure 23% (limit 10%)</code>. The hold ends under half
    the limit, and one that outlasts <code>ORCA_ADMIT_PRESSURE_GRACE_SECONDS</code> with
    none of orca's runs going raises an alert and lets runs start one at a time. Without
    PSI (macOS) nothing is held. Ops › Control shows the reading, and every run gets
    <code>ORCA_MEMORY_PRESSURE_FILE</code> to lower its own parallelism while it's high.
  </p>
  <p>
    <strong>A cgroup per run</strong> (since 0.15.0). Where orca can make cgroup v2
    cgroups, each local, control-placed and worker run gets one, its memory limit at its
    grant (else its request's maximum, else <code>ORCA_RUN_MEMORY_MB</code>), and the
    kernel kills it, it alone, <code>ORCA_RUN_MEMORY_MARGIN</code> (25) percent above
    that. The attempt fails <code>out of memory at &lt;limit&gt;</code>, and its retry and
    the pipeline's later runs ask for 1.5 times as much, up to <code>memory_gb</code>'s
    maximum. Where cgroups aren't available (macOS, cgroup v1, no delegation,
    <code>ORCA_CGROUPS=0</code>) the scheduler says why once and runs as before; on the
    Hetzner server, <code>orca-stack configure CGROUPS=1</code> turns them on
    (<a href={`${DOCS}/hetzner.md#a-cgroup-per-run`} rel="noopener">hetzner.md</a>).
    <a href={`${DOCS}/orca-toml.md#requests-and-grants`} rel="noopener">orca-toml.md</a>
    has all of it, and the <a href="/s/orca/docs/roadmap">roadmap</a> what comes next.
  </p>

  <h2 id="watchdog">The watchdog</h2>
  <p>
    Every <code>ORCA_WATCHDOG_SECONDS</code> the scheduler checks instance launches,
    estimated cost, idle workers, failing attempts, stuck runs and the control host's
    memory and disk. A rule past one of its thresholds pauses its pipelines, shows a red
    banner and sends an alert; it never resumes anything. Unpausing the pipelines clears
    the trip, <code>orca watchdog ack</code> keeps them paused, and
    <code>orca watchdog snooze &lt;rule&gt; 2h</code> silences a rule. On the local runner
    the cost rule reads "fixed price" and never trips
    (<a href={`${DOCS}/watchdog.md`} rel="noopener">watchdog.md</a>).
  </p>
  <CodeBlock label="shell" code={`./build/orca watchdog status
control   memory 98.30 % (trips over 90.00, past), disk 10.60 % (trips over 85.00)  TRIPPED on memory`} />

  <h2 id="alerts">Alerts</h2>
  <p>
    With <code>ORCA_NOTIFY_URL</code> set to an <a href="https://ntfy.sh" rel="noopener">ntfy</a>
    topic, the scheduler pushes watchdog trips, runs that failed after their last retry,
    stalled fills, a full control disk and lost workers to your phone, each at most once
    per half hour, with a link into the UI. <code>orca notify test</code> checks it
    (<a href={`${DOCS}/alerts.md`} rel="noopener">alerts.md</a>). For one server at a fixed
    price, the <a href={`${DOCS}/hetzner.md`} rel="noopener">Hetzner runbook</a> sets all
    of this up.
  </p>

  <h2 id="state">Runs in Postgres</h2>
  <p>
    With <code>ORCA_DATABASE_URL</code> set, the binary creates and migrates an
    <code>orca</code> schema at start-up and records every run, every step of every
    partition, and every attempt, with the inputs and outputs of each. Each change of
    state is one transaction.
  </p>
  <CodeBlock label="shell" code={`export ORCA_DATABASE_URL=postgresql:///orca
./build/gharchive run --partitions 2025-01-01..2025-01-03
./build/gharchive status 7        # run 7's steps and attempts
./build/gharchive resume 7`} />
  <p>
    <code>resume</code> reruns every step that hasn't succeeded, in order, with its
    recorded input; steps that succeeded are read back, not run again. A run started by a
    binary with a different registry hash is refused unless
    <code>--allow-new-code</code> is passed.
  </p>
  <p>
    One process owns a run at a time. It holds the run with a heartbeat, written from a
    thread with its own connection, and <code>resume</code> refuses a run whose heartbeat
    is younger than <code>ORCA_STALE_SECONDS</code>. A run whose process was killed goes
    stale and can be resumed; a run that ended can be resumed at once. Each attempt also
    checks that its process still owns the run, so a process that lost its run stops at
    its next step rather than racing the new owner. <code>tests/kill.sh</code> kills a
    run at a random step with <code>kill -9</code>, resumes it, and checks every step
    ran to success exactly once.
  </p>
  <p>
    Postgres must keep <code>synchronous_commit</code> on: with it off, an immediate
    restart of the server can lose commits it already acknowledged. The chaos test from
    <a href={`${ORCA_PRS}/6`} rel="noopener">PR #6</a> found this when a run's row
    vanished.
  </p>

  <h2 id="deploys">Deploys and rollbacks</h2>
  <p>
    On the <a href={`${DOCS}/hetzner.md`} rel="noopener">Hetzner stack</a>,
    <code>deploy.sh &lt;tag&gt;</code> replaces only the containers that changed, the UI
    and apps without downtime, and pauses the pipelines only when it replaces the
    scheduler, whose restart would kill its runs. It backs the database up first, and
    <code>deploy.sh --rollback</code> goes back to the tags deployed before; an older
    orca runs on a newer schema whose migrations since are additive.
    <a href="/s/orca/docs/deploy">Deploying</a> has the rest: overlapping schedulers,
    settings and SOPS secrets, and rescaling.
  </p>

  <h2 id="logs">Logs</h2>
  <p>
    With <code>ORCA_LOGS</code> set to a directory, each attempt writes
    <code>&lt;pipeline&gt;/&lt;run&gt;/&lt;step&gt;/&lt;partition&gt;/&lt;attempt&gt;.log</code>:
    its start, its end, its error, and its <code>ctx.log</code> lines with UTC
    timestamps. The path is recorded with the attempt and shown by
    <code>status &lt;run&gt;</code>. A run with Dista tasks writes the runtime's timeline
    beside them as <code>timeline.json</code>, in Chrome's trace format, which Perfetto
    opens. The scheduler keeps a run's driver output as <code>driver.log</code>, and an
    EC2 run's head and workers upload theirs to
    <code>cluster/&lt;role&gt;-&lt;instance&gt;.log</code> every
    <code>ORCA_CLUSTER_LOG_SECONDS</code> while they run, as an instance can go without
    notice.
  </p>
  <p>
    <code>ORCA_LOGS</code> and <code>ORCA_WAREHOUSE</code> can be locations in object
    storage, <code>s3://bucket/prefix</code>, configured from the <code>AWS_*</code>
    environment or the instance's role. An object can't be appended to, so a log is
    written to a file under <code>ORCA_LOG_STAGE</code> and uploaded when it's complete:
    an attempt's when the attempt ends, a timeline when the run does. The UI reads them
    back from wherever they are.
  </p>

  <h2 id="metrics">Machine metrics</h2>
  <p>
    Beside every process doing a run's work, the runner starts
    <code>&lt;binary&gt; sample</code>, which writes a JSON line of the machine's CPU,
    memory, disk, disk I/O and network every <code>ORCA_SAMPLE_SECONDS</code> to
    <code>&lt;pipeline&gt;/&lt;run&gt;/metrics/&lt;instance&gt;.jsonl</code> under
    <code>ORCA_LOGS</code>; since 0.15.0 <code>orca worker</code> does the same beside
    each run it starts, as <code>metrics/worker-&lt;name&gt;.jsonl</code>. A run's page
    draws them as its Machines section, on the same time axis as its steps, and marks the
    stretches where memory use or a disk was over 90% or CPU steal over 20%, which explain
    most slow or failed runs. They are the machine's numbers; the run's own peak memory
    and CPU are in its <a href="/s/orca/docs/run#resources">Resources</a> card.
  </p>

  <h2 id="lineage">Lineage</h2>
  <p>
    Every read and commit a step makes is recorded with its
    <a href="/s/orca/docs/build#datasets">dataset</a>, so lineage is two walks over them.
    Back from a snapshot: the run, step, partition and code that made it, the snapshots
    that attempt read, what made each of those, and so on, to sources no Orca run made.
    Forward: everything made from it. Both stop after 20 steps.
  </p>
  <CodeBlock label="output" code={`$ ./build/orca lineage lake.report
