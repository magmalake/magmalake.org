---
import OrcaDocs from "../../../../components/OrcaDocs.astro";
import CodeBlock from "../../../../components/CodeBlock.astro";
import { ORCA_REPO, orcaDocs } from "../../../../data/orca";

const description =
  "How to use Orca: installing it, then writing a pipeline, its command line, scheduling and running it here or on Kubernetes or EC2, the web UI, and debugging failed runs, each on a page of its own.";

const about: Record<string, string> = {
  "/s/orca/docs/build":
    "Steps and pipelines, partitions by date or by name, schedules, Iceberg tables and datasets, sensors, Dista inside steps, and building the binaries.",
  "/s/orca/docs/cli":
    "The commands you type, on a pipeline binary and on orca, the ones orca runs for you, and how the same binary acts locally or on AWS.",
  "/s/orca/docs/run":
    "The scheduler, runs on Kubernetes and EC2, runs in Postgres, logs and machine metrics, lineage and rebuilds, the environment, and what happens when things fail.",
  "/s/orca/docs/ui":
    "The pages and their JSON, the actions, logins, timelines and links to the code.",
  "/s/orca/docs/debug":
    "Where a failed run's errors and logs are, adding context to errors, symbolized crash dumps, reproducing a partition locally, and resuming it.",
};
---

<OrcaDocs href="/s/orca/docs" description={description}>
  <p class="eyebrow">Docs</p>
  <h1 class="section-title">Using Orca</h1>
  <p class="lede">
    Orca turns a Mojo file of steps into a pipeline binary with a command line, and a
    scheduler runs those binaries on this machine, on Kubernetes or on EC2, recording every
    run in Postgres. This page installs it; the pages below cover the rest. The plan is in
    the repository's <a href={`${ORCA_REPO}/blob/main/DESIGN.md`} rel="noopener">DESIGN.md</a>.
  </p>

  <h2 id="pages">The docs</h2>
  <ul class="docs-list">
    {orcaDocs.slice(1).map((d) => (
      <li><a href={d.href}><strong>{d.title}</strong></a>: {about[d.href]}</li>
    ))}
  </ul>

  <h2 id="install">Install it</h2>
  <p>
    Orca is the mojoshelf tin <code>orca-mojo</code>. With pixi and mojoshelf's
    <code>pixi shelf</code> installed, a new project adds it, and the tins it needs come
    with it:
  </p>
  <CodeBlock label="shell" code={`pixi init -c https://conda.modular.com/max-nightly -c conda-forge lake && cd lake
sed -i.bak 's/^\\[workspace\\]/[workspace]\\npreview = ["pixi-build"]/' pixi.toml   # tins build with pixi-build
pixi add "mojo-compiler==1.2.0"
pixi shelf add orca-mojo`} />
  <p>
    A pipeline is one Mojo file whose <code>main</code> hands it to
    <code>orca_main</code>, compiled into a binary of its own. Build one and run it in
    memory to try it:
  </p>
  <CodeBlock label="shell" code={`pixi run mojo build -I src pipelines/lake.mojo -o build/lake
./build/lake run --partitions 2024-01..2024-03`} />
  <p>
    <a href="/s/orca/docs/build">Writing a pipeline</a> says what goes in the file, and
    how to build the <code>orca</code> command that schedules it.
  </p>

  <h2 id="playground">The playground</h2>
  <p>
    To see the UI before running anything real, the repository's playground starts it on
    this machine with a throwaway Postgres, the example pipelines and their runs, two of
    them on a stand-in EC2:
  </p>
  <CodeBlock label="shell" code={`git clone ${ORCA_REPO} && cd orca.mojo
git clone https://github.com/magmalake/dista.mojo ../dista.mojo
git clone https://github.com/magmalake/k8s.mojo ../k8s.mojo
pixi run playground          # then http://127.0.0.1:8270, log in as demo / demo-password`} />

  <h2 id="source">From source</h2>
  <p>
    Building from source works the same way: the repository compiles Dista and k8s.mojo
    from those checkouts beside it, <code>pixi run test</code> runs the tests, and
    <code>pixi run orca</code> builds the scheduler to <code>build/orca</code>. It targets
    Mojo 1.2.0, with a nightly environment alongside. Its state goes through postgres-mojo,
    which loads libpq; the tests start a throwaway Postgres server of their own.
    <code>orca.tables</code>, the Iceberg part, has its tests in the <code>data</code>
    environment (<code>pixi run -e data test-tables</code>).
  </p>
</OrcaDocs>

<script is:inline>
  // This page used to hold every section. Old links and the UI's docs
  // links (ORCA_DOCS_URL#<section>) go to the section's new page.
  (function () {
    var to = {
      build: "build#binaries", steps: "build#steps", pipelines: "build#pipelines",
      partitions: "build#partitions", keyed: "build#keyed", tables: "build#tables",
      datasets: "build#datasets", sensors: "build#sensors", dista: "build#dista",
      versions: "build#versions",
      cli: "cli",
      scheduler: "run#scheduler", runners: "run#runners", state: "run#state",
      logs: "run#logs", metrics: "run#metrics", lineage: "run#lineage",
      rebuilds: "run#rebuilds", env: "run#env", failures: "run#failures",
      ui: "ui",
    };
    var h = location.hash.slice(1);
    if (Object.prototype.hasOwnProperty.call(to, h)) location.replace("/s/orca/docs/" + to[h]);
  })();
</script>
