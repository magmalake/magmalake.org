---
/**
 * One page per tin, from src/data/tins.ts, perf.ts and upstream.ts. Orca and
 * Dista have sections of their own (`site`), so they are left out here.
 */
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PerfTable from "../../components/PerfTable.astro";
import UpstreamList from "../../components/UpstreamList.astro";
import {
  tins,
  TIER_LABEL,
  STATUS_LABEL,
  statusOf,
  slugOf,
  pageOf,
  readmeOf,
  installOf,
  type Tin,
} from "../../data/tins";
import { perfFor, passesFor, MEASURED_ON } from "../../data/perf";
import { upstreamFor } from "../../data/upstream";

export function getStaticPaths() {
  return tins.filter((t) => !t.site).map((t) => ({ params: { tin: slugOf(t) }, props: { tin: t } }));
}

interface Props {
  tin: Tin;
}
const { tin } = Astro.props;
const slug = slugOf(tin);
const status = statusOf(tin);
const groups = perfFor(slug);
const passes = passesFor(slug);
const issues = upstreamFor(slug);
const siblings = tins.filter((t) => t.tier === tin.tier && t !== tin);
const doc = await getEntry("tindocs", slug);
const Docs = doc ? (await render(doc)).Content : null;
const description = `${tin.name}, a magmalake tin: ${tin.what.split(". ")[0].replace(/\.$/, "")}.`;
---

<Base title={tin.name} description={description}>
  <section class="section section--alt">
    <div class="wrap wrap--wide">
      <p class="eyebrow"><a href="/tins">Tins</a> · {TIER_LABEL[tin.tier]}</p>
      <h1 class="section-title tp__name">{tin.name}</h1>
      <p class="lede">{tin.what}</p>

      <div class="tp__facts">
        <div class="tp__fact tp__fact--install">
          <span class="tp__label">Install</span>
          {
            status === "shelf" ? (
              <CodeBlock code={installOf(tin)} label="shell" />
            ) : (
              <>
                <p class="tp__plain">Not on mojoshelf yet: build it from its repository.</p>
                <CodeBlock code={`git clone ${tin.repo}`} label="shell" />
              </>
            )
          }
        </div>
        <div class="tp__fact">
          <span class="tp__label">Version</span>
          <p class="tp__plain">
            <code>{tin.version}</code>
            {status === "shelf" ? " on mojoshelf" : `, ${STATUS_LABEL[status]}`}
          </p>
        </div>
        <div class="tp__fact">
          <span class="tp__label">Source</span>
          <p class="tp__plain tp__links">
            <a href={tin.repo} rel="noopener">GitHub</a>
            <a href={readmeOf(tin)} rel="noopener">README</a>
            {tin.benchmarks && <a href={tin.benchmarks} rel="noopener">Benchmark history</a>}
          </p>
        </div>
      </div>

      <nav class="tp__toc" aria-label="On this page">
        <a href="#what">What it does</a>
        <a href="#correctness">Correctness</a>
        <a href="#performance">Performance</a>
        <a href="#docs">Docs</a>
      </nav>
    </div>
  </section>

  <section class="section tp__section" id="what">
    <div class="wrap wrap--wide">
      <p class="eyebrow">What it does</p>
      <div class:list={["status-grid", "tp__grid", !tin.notYet && "tp__grid--one"]}>
        <div class="status-col status-col--yes">
          <h2 class="status-col__head">Works today</h2>
          <ul>{tin.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        {
          tin.notYet && (
            <div class="status-col status-col--no">
              <h2 class="status-col__head">Not yet</h2>
              <ul>{tin.notYet.map((n) => <li>{n}</li>)}</ul>
              {tin.notYetNote && <p class="status-col__fine" set:html={tin.notYetNote} />}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--alt tp__section" id="correctness">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Correctness</p>
      <div class="tp__oracle">
        <span class="tp__oracle-label">Checked against</span>
        <span class="tp__oracle-value">{tin.oracle}</span>
      </div>
      {tin.evidence && <div class="prose tp__prose">{tin.evidence.map((e) => <p>{e}</p>)}</div>}
      {issues.length > 0 && <UpstreamList issues={issues} />}
    </div>
  </section>

  <section class="section tp__section" id="performance">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Performance</p>
      {
        groups.length > 0 ? (
          <>
            <div class="tp__perf">{groups.map((g) => <PerfTable group={g} />)}</div>
            <p class="panel__fine tp__measured">
              {MEASURED_ON} <a href="/performance#method">How these were measured</a>.
            </p>
          </>
        ) : (
          <p class="lede">No hand-measured numbers for {tin.name} yet.</p>
        )
      }
      {
        passes.length > 0 && (
          <div class="panel tp__panel">
            <h3 class="panel__title">Found by profiling</h3>
            {passes.map((p) => (
              <p>
                <strong>{p.found}.</strong> {p.fix}
              </p>
            ))}
          </div>
        )
      }
      {
        tin.perfNotes?.map((n) => (
          <div class="panel tp__panel">
            <h3 class="panel__title">{n.title}</h3>
            {n.body.map((b) => <p set:html={b} />)}
          </div>
        ))
      }
      {
        tin.benchmarks && (
          <p class="tp__plain tp__history">
            Every merge also runs its benchmarks on a GitHub runner:{" "}
            <a href={tin.benchmarks} rel="noopener">the benchmark history</a>. Read it for
            trends; a shared runner is slower and noisier than the table.
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--alt tp__section" id="docs">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Docs</p>
      {
        Docs ? (
          <div class="tp__docs">
            <Docs />
            <p class="tp__docs-more">
              The full reference is <a href={readmeOf(tin)} rel="noopener">the README on GitHub</a>.
            </p>
          </div>
        ) : (
          <>
            <p class="lede">
              Docs for {tin.name} are not written yet. Until they are, the README on GitHub is
              the reference: what it covers, how to use it and how its tests run.
            </p>
            <a class="btn" href={readmeOf(tin)} rel="noopener">Read the README</a>
          </>
        )
      }
    </div>
  </section>

  <section class="section tp__section">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Also in {TIER_LABEL[tin.tier]}</p>
      <ul class="tp__siblings">
        {siblings.map((t) => <li><a href={pageOf(t)}>{t.name}</a> <span>{t.short}</span></li>)}
        <li><a href="/tins">Every tin</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; }

  .tp__name {
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }

  .tp__facts {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    margin-top: 2rem;
    align-items: start;
  }
  @media (max-width: 820px) {
    .tp__facts { grid-template-columns: 1fr; }
  }
  .tp__fact :global(.codeblock) { margin: 0.35rem 0 0; }
  .tp__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.35rem;
  }
  .tp__plain {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0.35rem 0 0;
  }
  .tp__links { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }

  .tp__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }
  .tp__toc a { color: var(--text-muted); text-decoration: none; }
  .tp__toc a:hover { color: var(--ember); }

  .tp__section { scroll-margin-top: 4rem; }

  .tp__grid { margin-top: 0; }
  .tp__grid--one { grid-template-columns: minmax(0, 1fr); max-width: 48rem; }

  .tp__oracle {
    max-width: 48rem;
    padding: 0.9rem 1.1rem;
    background: var(--lake-wash);
    border: 1px solid color-mix(in srgb, var(--lake) 22%, transparent);
    border-radius: var(--radius-sm);
  }
  .tp__oracle-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lake);
    margin-bottom: 0.25rem;
  }
  .tp__oracle-value { font-size: 0.9375rem; line-height: 1.5; }
  .tp__prose { margin-top: 1.25rem; color: var(--text-muted); }

  .tp__measured { margin-top: 1rem; max-width: 72ch; }
  .tp__panel { margin-top: 1.5rem; max-width: 52rem; }
  .tp__history { margin-top: 1.5rem; max-width: 72ch; }

  .tp__siblings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.6rem 1.5rem;
  }
  .tp__siblings a { font-family: var(--font-mono); font-weight: 600; text-decoration: none; }
  .tp__siblings a:hover { text-decoration: underline; }
  .tp__siblings span { display: block; font-size: 0.8125rem; color: var(--text-muted); }
  /* The Docs section: Markdown from src/content/tindocs, set like a blog
     post's body so code fences and tables look the same across the site. */
  .tp__docs { max-width: 46rem; }
  .tp__docs :global(h2) {
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    margin: 2.5rem 0 0.85rem;
  }
  .tp__docs :global(h2:first-child) { margin-top: 0.5rem; }
  .tp__docs :global(h3) {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    margin: 1.8rem 0 0.7rem;
  }
  .tp__docs :global(p) { margin: 0 0 1.15rem; line-height: 1.7; }
  .tp__docs :global(ul),
  .tp__docs :global(ol) { margin: 0 0 1.15rem 1.1rem; line-height: 1.7; }
  .tp__docs :global(li) { margin-bottom: 0.3rem; }
  .tp__docs :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 1.4rem;
  }
  .tp__docs :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 0 0 1.4rem;
    display: block;
    overflow-x: auto;
  }
  .tp__docs :global(th),
  .tp__docs :global(td) {
    text-align: left;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .tp__docs :global(th) {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tp__docs-more { color: var(--text-muted); font-size: 0.9375rem; }
</style>
