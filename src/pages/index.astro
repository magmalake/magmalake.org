---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import CodeTabs from "../components/CodeTabs.astro";
import CodeBlock from "../components/CodeBlock.astro";
import StackDiagram from "../components/StackDiagram.astro";
import { LIBS } from "../data/gharchive";
import { MOJOSHELF_INSTALL } from "../data/install";

const description =
  "Native Mojo data libraries, published as tins on mojoshelf: Parquet, Iceberg, Arrow, Avro, Thrift, the compression codecs, object storage, and Postgres and SQLite clients, with no Python or JVM in the path. Measured against pyarrow, including where they lose. The companion of morca.dev.";

const install = `pixi init app -c https://conda.modular.com/max -c conda-forge && cd app
sed -i.bak 's/^\\[workspace\\]/[workspace]\\npreview = ["pixi-build"]/' pixi.toml
pixi add "mojo-compiler==1.2.0"
pixi shelf add parquet-full-mojo    # Parquet with every codec`;
---

<Base title="Data libraries in Mojo" description={description} bare={false}>
  <Hero />

  <section class="section section--alt" id="what">
    <div class="wrap wrap--wide">
      <div class="home-points">
        <div class="home-point">
          <h2 class="home-point__title">Native formats</h2>
          <p>
            <a href="/s/parquet">Parquet</a>, <a href="/s/iceberg">Iceberg</a>,
            <a href="/s/avro">Avro</a> and <a href="/s/thrift">Thrift</a> are implemented in
            Mojo, and reads come back as <a href="/s/arrow-mlake">Arrow</a> arrays. Iceberg reads
            and writes: scan planning, deletes and deletion vectors, appends, overwrites and
            schema changes, through a filesystem, REST or SQL catalog. Beside them are
            <a href="/s/objectstore">objectstore</a> for local files, HTTP and S3,
            <a href="/s/postgres">postgres</a> and <a href="/s/sqlite">sqlite</a> clients and
            <a href="/s/threads">threads</a>, and a packaged build of upstream's
            <a href="/s/flare_mlake">flare</a> for networking and HTTP.
            Snappy, deflate and the hashes are Mojo too; libzstd, liblz4, libbrotli and libcurl
            are linked.
          </p>
        </div>

        <div class="home-point">
          <h2 class="home-point__title">Measured against pyarrow</h2>
          <p>
            Reading a 1M-row Parquet file on one core takes 3.77 ms, against 8.0 ms for pyarrow
            on one thread. With four workers it takes 1.96 ms, against 2.57 ms for pyarrow on
            all ten CPUs. Avro decodes manifest-shaped records 10.7× faster than fastavro. It
            loses too: pyarrow is about 1.17× faster on nested and mixed data, and about 1.1×
            ahead on an Iceberg scan. <a href="/performance">The performance page</a> has the
            numbers and how they were taken.
          </p>
        </div>

        <div class="home-point">
          <h2 class="home-point__title">Checked against an outside implementation</h2>
          <p>
            Each of magmalake's own tins has a correctness oracle, an outside implementation it
            has to agree with in CI, and its page says which. They are Apache-2.0 and tested on
            stable Mojo 1.2.0 and the current nightly, on macOS and Linux.
          </p>
        </div>

        <div class="home-point">
          <h2 class="home-point__title">Installed from mojoshelf</h2>
          <p>
            Each tin is a pixi package on <a href="https://mojoshelf.org" rel="noopener">mojoshelf</a>,
            added with one command that brings its dependencies with it. Take only the ones you
            need. <a href={MOJOSHELF_INSTALL} rel="noopener">mojoshelf's guide</a> installs the
            <code>shelf</code> command.
          </p>
          <CodeBlock code={install} label="shell" />
        </div>

        <div class="home-point">
          <h2 class="home-point__title">The companion of Morca</h2>
          <p>
            magmalake is the companion of <a href="https://morca.dev" rel="noopener">Morca</a>,
            which builds data pipelines on these tins.
            <a href="https://morca.dev/dista/" rel="noopener">Dista</a>, which runs Mojo functions
            across a cluster, is part of Morca. Both are used to build
            <a href={LIBS} rel="noopener">mojourney.dev</a>, the census of Mojo on GitHub.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="examples">
    <div class="wrap wrap--wide">
      <p class="eyebrow">In code</p>
      <h2 class="section-title">Three of the tins</h2>
      <CodeTabs />
    </div>
  </section>

  <section class="section section--alt" id="tins">
    <div class="wrap wrap--wide">
      <p class="eyebrow">The tins</p>
      <h2 class="section-title">Every tin, layer by layer</h2>
      <p class="lede">
        Each box links to the tin's page: what it is, how to install it, what proves it and how
        fast it is. <a href="/tins">The tins page</a> says more about how they fit together.
      </p>
      <StackDiagram />
    </div>
  </section>
</Base>

<style>
  .home-points {
    display: grid;
    gap: 1.75rem;
    max-width: var(--measure);
  }
  .home-point__title {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }
  .home-point p {
    color: var(--text-muted);
    line-height: 1.65;
  }
  .home-point :global(.codeblock) { margin: 1rem 0 0; }
  #tins .lede { margin-bottom: 2.5rem; }
</style>
