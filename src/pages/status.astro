---
import Base from "../layouts/Base.astro";
import TakeATinCta from "../components/TakeATinCta.astro";

const description =
  "What works today, what is not built yet, and where the roadmap lives.";

const worksToday = [
  "Iceberg format v1–v3 reads, with position deletes, equality deletes and v3 deletion vectors",
  "Schema evolution and nested types through the read path",
  "Fast-append, row-level delete both copy-on-write and merge-on-read",
  "Overwrite and dynamic partition overwrite",
  "expire_snapshots",
  "Filesystem, REST and SQL catalogs — the SQL catalog on SQLite for development, or on PostgreSQL",
  "Local, HTTP, S3, GCS and Azure IO",
];

const notYet = [
  "Compaction — rewrite_manifests",
  "Encryption",
  "More than 2 GiB of string data in one Parquet column chunk",
  "Predicates inside list and map elements",
];
---

<Base title="Status" description={description}>
  <section class="section">
    <div class="wrap wrap--wide">
      <p class="eyebrow">Status</p>
      <h1 class="section-title">Active, v0.x</h1>
      <p class="lede">
        Reads are complete for Iceberg format v1 through v3. Writes cover the common table
        operations. Several things are genuinely missing, and they are listed here rather
        than left to be discovered.
      </p>

      <div class="status-grid">
        <div class="status-col status-col--yes">
          <h3 class="status-col__head">Works today</h3>
          <ul>{worksToday.map((w) => <li>{w}</li>)}</ul>
        </div>
        <div class="status-col status-col--no">
          <h3 class="status-col__head">Not yet</h3>
          <ul>{notYet.map((n) => <li>{n}</li>)}</ul>
          <p class="status-col__fine">
            The spec's v4 drafts — relative paths and <code>content_stats</code> — are tracked
            but not implemented. What is proposed but unbuilt lives in
            <a href="https://github.com/magmalake/.github/issues" rel="noopener">the issue
            tracker</a>. The last spec there,
            <a href="https://github.com/magmalake/.github/issues/1" rel="noopener">a PostgreSQL
            tin</a>, shipped as postgres.mojo and put the SQL catalog on a server.
          </p>
        </div>
      </div>

      <TakeATinCta />
    </div>
  </section>
</Base>

<style>
  .status-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 820px) {
    .status-grid { grid-template-columns: 1fr; }
  }

  .status-col {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
  }
  .status-col__head {
    font-size: 0.9375rem;
    margin-bottom: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .status-col--yes .status-col__head { color: var(--lake); }
  .status-col--no .status-col__head { color: var(--ember); }

  .status-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .status-col li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .status-col li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .status-col--yes li::before { content: "+"; color: var(--lake); }
  .status-col--no li::before { content: "\2013"; color: var(--ember); }

  .status-col__fine {
    margin: 1.1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }
</style>
