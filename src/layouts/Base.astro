---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { POSTHOG_KEY } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Omit the site-name suffix when the page title already carries it. */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const fullTitle = bare ? title : `${title} — magmalake`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://magmalake.org");
const posthogEnabled = POSTHOG_KEY.startsWith("phc_");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d11" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="magmalake" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    {/* Theme is resolved before first paint so a stored choice never flashes. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("ml-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {
          /* private mode, blocked storage: fall back to the system theme */
        }
      })();
    </script>

    {/*
      PostHog product analytics, proxied first-party through /ph (see
      worker/posthog-proxy.js) so ad-blockers don't drop it. `persistence:
      'memory'` means no cookies and no localStorage, so there is nothing to
      disclose and no consent banner is needed. `api_host` is derived from
      `location.origin` at runtime rather than hardcoded so this works the
      same on the apex domain, on www., and under `wrangler dev`.
    */}
    {posthogEnabled && (
      <>
        <script defer src="/ph/static/array.js"></script>
        <script is:inline define:vars={{ POSTHOG_KEY }}>
          window.addEventListener("DOMContentLoaded", function () {
            if (window.posthog) posthog.init(POSTHOG_KEY, {
              api_host: location.origin + '/ph',
              ui_host: 'https://us.posthog.com',
              defaults: '2025-05-24',
              persistence: 'memory',
              capture_exceptions: true
            });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        padding: 0.6rem 1rem;
        font-size: 0.875rem;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
    </style>
  </body>
</html>
