---
/**
 * The layering, drawn from src/data/tins.ts in CSS grid rather than SVG, so
 * the labels stay readable at every width, the whole thing reflows to a
 * single column on a phone, and a new tin appears by adding it to the data.
 */
import { tins, TIERS, TIER_LABEL, statusOf, STATUS_LABEL } from "../data/tins";

const bands = TIERS.map((tier) => ({
  tier,
  label: TIER_LABEL[tier],
  tins: tins.filter((t) => t.tier === tier),
}));
---

<figure class="stack">
  {
    bands.map((band, i) => (
      <>
        {i > 0 && <div class="joins" aria-hidden="true"><i /><i /><i /></div>}
        <div class:list={["stack__band", band.tier === "execution" && "stack__band--top"]}>
          <span class="stack__tier">{band.label}</span>
          <div class:list={["stack__row", band.tins.length === 1 && "stack__row--1"]}>
            {band.tins.map((t) => {
              const status = statusOf(t);
              return (
                <a
                  class:list={[
                    "box",
                    band.tier === "table" && "box--lead",
                    status === "planned" && "box--planned",
                  ]}
                  href={t.repo}
                  rel="noopener"
                >
                  <span class="box__name">
                    {t.name}
                    {status !== "shelf" && (
                      <span class="box__status">{STATUS_LABEL[status]}</span>
                    )}
                  </span>
                  <span class="box__sub">{t.short}</span>
                </a>
              );
            })}
          </div>
        </div>
      </>
    ))
  }

  <figcaption>
    Each box is a tin with its own repository, its own tests and its own release cadence,
    and each layer uses only the ones below it. Outside the diagram there is only libzstd,
    liblz4, libbrotli, libcurl, libpq, SQLite, the Restate Rust SDK and the system
    pthreads. Boxes marked
    <em>from source</em> work today but aren't on mojoshelf yet; <em>planned</em> ones are
    designed, not built.
  </figcaption>
</figure>

<style>
  .stack {
    margin: 0;
    --gap: 0.7rem;
  }

  .stack__band { position: relative; }

  .stack__tier {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .stack__row {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
  }
  .stack__row--1 { grid-template-columns: 1fr; }

  .box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.box:hover {
    border-color: var(--ember);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }

  .box--lead {
    padding: 1.15rem 1.25rem;
    border-color: var(--border-strong);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--ember) 7%, var(--surface)),
      var(--surface) 62%
    );
  }
  .box--lead .box__name { font-size: 1.2rem; color: var(--ember); }

  .stack__band--top .box {
    border-color: color-mix(in srgb, var(--lake) 45%, var(--border));
  }

  .box--planned {
    border-style: dashed;
    background: var(--surface-2);
  }

  .box__name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }

  .box__status {
    font-weight: 400;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .box__sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* connector ticks between bands */
  .joins {
    display: grid;
    height: 1.5rem;
    gap: var(--gap);
    margin-block: 0.15rem 0.6rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .joins i {
    display: block;
    width: 1px;
    height: 100%;
    margin-inline: auto;
    background: linear-gradient(
      to bottom,
      var(--border-strong),
      color-mix(in srgb, var(--border-strong) 30%, transparent)
    );
  }

  figcaption {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 66ch;
  }

  @media (max-width: 880px) {
    .stack__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stack__row--1 { grid-template-columns: 1fr; }
    .joins { display: none; }
    .stack__band { margin-bottom: 1.5rem; }
  }

  @media (max-width: 520px) {
    .stack__row { grid-template-columns: 1fr; }
  }
</style>
