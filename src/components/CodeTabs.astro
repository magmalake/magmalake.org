---
/**
 * Code in tabs. With no `tabs`, the home page's examples, one per layer, from
 * src/data/examples.ts. With `tabs`, any set, such as a tin's install two
 * ways (src/data/install.ts). Without JavaScript the first tab shows and the
 * others stay hidden. In the Markdown twin every panel shows, each under its
 * tab's name. Mojo keywords and strings are coloured at build time, so the
 * examples stay plain text there.
 */
import "../styles/codetabs.css";
import { examples } from "../data/examples";
import type { Tab } from "../data/install";

interface Props {
  tabs?: Tab[];
  /** What the tabs are, for screen readers. */
  label?: string;
  /** A Copy button on each panel. */
  copy?: boolean;
}
const {
  tabs = examples.map((e) => ({ ...e, mojo: true })),
  label = "Code examples",
  copy = false,
} = Astro.props;

const KEYWORDS = new Set([
  "from", "import", "def", "var", "comptime", "return", "for", "in", "raises", "mut",
]);

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

function highlight(code: string): string {
  return code.replace(/("[^"]*"|'[^']*'|[A-Za-z_]+|[^"'A-Za-z_]+)/g, (tok) => {
    if (tok.startsWith('"') || tok.startsWith("'")) return `<span class="s">${esc(tok)}</span>`;
    if (KEYWORDS.has(tok)) return `<span class="k">${tok}</span>`;
    return esc(tok);
  });
}
---

<div class="codetabs" data-codetabs>
  <div class="codetabs__bar" role="tablist" aria-label={label}>
    {
      tabs.map((t, i) => (
        <button
          class="codetabs__tab"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          type="button"
        >
          {t.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((t, i) => (
      <div
        class:list={["codetabs__panel", copy && "codetabs__panel--copy"]}
        role="tabpanel"
        id={`panel-${t.id}`}
        aria-labelledby={`tab-${t.id}`}
        hidden={i !== 0}
      >
        <p class="codetabs__twin">{t.label}:</p>
        {copy && (
          <button type="button" class="codeblock__copy" data-copy data-pagefind-ignore aria-label="Copy the code">
            Copy
          </button>
        )}
        <pre><code set:html={t.mojo ? highlight(t.code) : esc(t.code)} /></pre>
        {(t.note || t.href) && (
          <p class="codetabs__note">
            <Fragment set:html={t.note ?? ""} /> {t.href && <a href={t.href}>More</a>}
          </p>
        )}
      </div>
    ))
  }
</div>

<script>
  import "../scripts/codetabs";
</script>
