---
import Logo from "./Logo.astro";

const links = [
  { href: "/", label: "Overview" },
  { href: "/tins", label: "Tins" },
  { href: "/performance", label: "Performance" },
  { href: "/correctness", label: "Correctness" },
  { href: "/status", label: "Status" },
  { href: "/blog", label: "Writing" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="nav">
  <div class="wrap wrap--wide nav__inner">
    <a class="nav__brand" href="/" aria-label="magmalake home">
      <Logo />
      <span class="nav__word">magmalake</span>
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Sections">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__end">
      <a class="nav__ext" href="/issues">Issues</a>
      <a class="nav__ext" href="https://github.com/magmalake" rel="noopener">GitHub</a>
      <button
        class="nav__theme"
        type="button"
        id="theme-toggle"
        aria-label="Toggle colour theme"
        title="Toggle colour theme"
      >
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="10" cy="10" r="3.6" />
          <path d="M10 1.6v2M10 16.4v2M1.6 10h2M16.4 10h2M4.1 4.1l1.4 1.4M14.5 14.5l1.4 1.4M15.9 4.1l-1.4 1.4M5.5 14.5l-1.4 1.4" />
        </svg>
      </button>
      <button
        class="nav__burger"
        type="button"
        id="nav-burger"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;

  const systemDark = () => window.matchMedia("(prefers-color-scheme: dark)").matches;

  btn?.addEventListener("click", () => {
    const current = root.getAttribute("data-theme") ?? (systemDark() ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("ml-theme", next);
    } catch {
      /* storage blocked: the toggle still works for this page view */
    }
  });

  const burger = document.getElementById("nav-burger");
  const navLinks = document.getElementById("nav-links");

  burger?.addEventListener("click", () => {
    const open = navLinks?.classList.toggle("nav__links--open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });

  // Collapse the mobile menu if the viewport grows past the breakpoint.
  window.matchMedia("(min-width: 940px)").addEventListener("change", (e) => {
    if (e.matches) {
      navLinks?.classList.remove("nav__links--open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.025em;
  }

  .nav__links {
    display: flex;
    gap: 1.35rem;
    margin-inline: auto;
    font-size: 0.875rem;
  }
  .nav__links a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav__links a:hover {
    color: var(--text);
    border-bottom-color: var(--ember);
  }
  .nav__links a[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--ember);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .nav__ext {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .nav__ext:hover { color: var(--text); }

  .nav__theme,
  .nav__burger {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }
  .nav__theme:hover,
  .nav__burger:hover {
    color: var(--ember);
    border-color: var(--border-strong);
  }

  .nav__burger { display: none; }

  @media (max-width: 940px) {
    .nav__links {
      display: none;
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 0.5rem 1.15rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      box-shadow: var(--shadow);
    }
    .nav__links--open { display: flex; }
    .nav__links a {
      padding: 0.7rem 0.2rem 0.7rem 0.7rem;
      border-bottom: 1px solid var(--border);
      border-left: 2px solid transparent;
    }
    .nav__links a:last-child { border-bottom: 0; }
    .nav__links a[aria-current="page"] {
      color: var(--ember);
      border-left-color: var(--ember);
    }

    .nav__end { margin-left: auto; }
    .nav__burger { display: grid; }
  }
</style>
