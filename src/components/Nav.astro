---
import Logo from "./Logo.astro";

const links = [
  { href: "/#what", label: "What this is" },
  { href: "/#stack", label: "Stack" },
  { href: "/#tins", label: "Tins" },
  { href: "/#performance", label: "Performance" },
  { href: "/#correctness", label: "Correctness" },
  { href: "/#status", label: "Status" },
];
---

<header class="nav">
  <div class="wrap wrap--wide nav__inner">
    <a class="nav__brand" href="/" aria-label="magmalake home">
      <Logo />
      <span class="nav__word">magmalake</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__end">
      <a class="nav__ext" href="https://github.com/magmalake" rel="noopener">GitHub</a>
      <button
        class="nav__theme"
        type="button"
        id="theme-toggle"
        aria-label="Toggle colour theme"
        title="Toggle colour theme"
      >
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="10" cy="10" r="3.6" />
          <path d="M10 1.6v2M10 16.4v2M1.6 10h2M16.4 10h2M4.1 4.1l1.4 1.4M14.5 14.5l1.4 1.4M15.9 4.1l-1.4 1.4M5.5 14.5l-1.4 1.4" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;

  const systemDark = () => window.matchMedia("(prefers-color-scheme: dark)").matches;

  btn?.addEventListener("click", () => {
    const current = root.getAttribute("data-theme") ?? (systemDark() ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("ml-theme", next);
    } catch {
      /* storage blocked: the toggle still works for this page view */
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.025em;
  }

  .nav__links {
    display: flex;
    gap: 1.35rem;
    margin-inline: auto;
    font-size: 0.875rem;
  }
  .nav__links a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav__links a:hover {
    color: var(--text);
    border-bottom-color: var(--ember);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .nav__ext {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .nav__ext:hover { color: var(--text); }

  .nav__theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }
  .nav__theme:hover {
    color: var(--ember);
    border-color: var(--border-strong);
  }

  @media (max-width: 940px) {
    .nav__links { display: none; }
    .nav__end { margin-left: auto; }
  }
</style>
