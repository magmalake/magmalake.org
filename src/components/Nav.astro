---
import Logo from "./Logo.astro";

const links = [
  { href: "/", label: "Overview" },
  { href: "/tins", label: "Tins" },
  { href: "/performance", label: "Performance" },
  { href: "/correctness", label: "Correctness" },
  { href: "/status", label: "Status" },
  { href: "/blog", label: "Blog" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="nav">
  <div class="wrap wrap--wide nav__inner">
    <a class="nav__brand" href="/" aria-label="magmalake home">
      <Logo />
      <span class="nav__word">magmalake</span>
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Sections">
      {
        links.map((l) => (
          <a
            class="nav__section"
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }

      <span class="nav__divider" aria-hidden="true"></span>

      <a class="nav__ext" href="/issues">
        <span class="nav__ext-label">Issues</span>
        <svg class="nav__ext-arrow" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M7.4 12.6 12.6 7.4M7.9 7.4h4.7v4.7" />
        </svg>
      </a>

      <a
        class="nav__ext nav__ext--gh"
        href="https://github.com/magmalake"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="nav__gh" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
             fill="currentColor">
          <path d="M8 .2a8 8 0 0 0-2.53 15.6c.4.07.55-.18.55-.39l-.01-1.36c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.47.55.39A8 8 0 0 0 8 .2Z" />
        </svg>
        <span class="nav__ext-label">GitHub</span>
        <svg class="nav__ext-arrow" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
             stroke-linejoin="round">
          <path d="M7.4 12.6 12.6 7.4M7.9 7.4h4.7v4.7" />
        </svg>
      </a>
    </nav>

    <div class="nav__end">
      <button
        class="nav__theme"
        type="button"
        id="theme-toggle"
        aria-label="Toggle colour theme"
        title="Toggle colour theme"
      >
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="10" cy="10" r="3.6" />
          <path d="M10 1.6v2M10 16.4v2M1.6 10h2M16.4 10h2M4.1 4.1l1.4 1.4M14.5 14.5l1.4 1.4M15.9 4.1l-1.4 1.4M5.5 14.5l-1.4 1.4" />
        </svg>
      </button>
      <button
        class="nav__burger"
        type="button"
        id="nav-burger"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;

  const systemDark = () => window.matchMedia("(prefers-color-scheme: dark)").matches;

  btn?.addEventListener("click", () => {
    const current = root.getAttribute("data-theme") ?? (systemDark() ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("ml-theme", next);
    } catch {
      /* storage blocked: the toggle still works for this page view */
    }
  });

  const burger = document.getElementById("nav-burger");
  const navLinks = document.getElementById("nav-links");

  burger?.addEventListener("click", () => {
    const open = navLinks?.classList.toggle("nav__links--open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });

  // Collapse the mobile menu if the viewport grows past the breakpoint.
  window.matchMedia("(min-width: 940px)").addEventListener("change", (e) => {
    if (e.matches) {
      navLinks?.classList.remove("nav__links--open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.025em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin-inline: auto;
    font-size: 0.875rem;
  }
  .nav__links a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links a:hover { color: var(--text); }

  .nav__section {
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav__section:hover { border-bottom-color: var(--ember); }
  .nav__section[aria-current="page"] {
    color: var(--text);
    border-bottom-color: var(--ember);
  }

  /* Hairline between the site sections and the two outbound links. */
  .nav__divider {
    width: 1px;
    height: 1.05rem;
    background: var(--border-strong);
    margin-inline: -0.35rem;
  }

  .nav__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Desktop: the GitHub mark stands in for the word, and the outbound arrow
     is left to the burger panel, where the links are plain text. */
  .nav__ext-arrow { display: none; }
  .nav__ext--gh .nav__ext-label { display: none; }
  .nav__ext--gh {
    /* Negative margin keeps the wider hit area from changing the bar height. */
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .nav__gh { display: block; }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .nav__theme,
  .nav__burger {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }
  .nav__theme:hover,
  .nav__burger:hover {
    color: var(--ember);
    border-color: var(--border-strong);
  }

  .nav__burger { display: none; }

  @media (max-width: 940px) {
    .nav__links {
      display: none;
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 0.5rem 1.15rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      box-shadow: var(--shadow);
    }
    .nav__links--open { display: flex; }
    .nav__links a {
      padding: 0.7rem 0.2rem 0.7rem 0.7rem;
      border-bottom: 1px solid var(--border);
      border-left: 2px solid transparent;
    }
    .nav__links a:last-child { border-bottom: 0; }
    /* The outbound rows pick up the same hover as the section rows here. */
    .nav__links a:hover { border-bottom-color: var(--ember); }
    .nav__links .nav__section[aria-current="page"] {
      color: var(--ember);
      border-left-color: var(--ember);
    }

    /* In the panel the two outbound links read as rows like the rest, with a
       quiet arrow after the label instead of a mark. */
    .nav__divider { display: none; }
    .nav__ext-arrow { display: block; }
    .nav__ext--gh { margin: 0; }
    .nav__ext--gh .nav__ext-label { display: inline; }
    .nav__ext--gh .nav__gh { display: none; }

    .nav__end { margin-left: auto; }
    .nav__burger { display: grid; }
  }
</style>
