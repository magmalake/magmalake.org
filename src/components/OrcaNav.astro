---
// Orca's header: SectionNav with Orca's pages.
import SectionNav from "./SectionNav.astro";
import { ORCA_REPO } from "../data/orca";
import { tinLinks } from "../data/tinpages";
import { tins } from "../data/tins";

const links = tinLinks(tins.find((t) => t.site === "/s/orca")!);
---

<SectionNav name="Orca" home="/s/orca" links={links} repo={ORCA_REPO} tin="orca" />
