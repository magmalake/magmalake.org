---
import CodeTabs from "./CodeTabs.astro";
import { tins, statusOf } from "../data/tins";

const tinCount = tins.filter((t) => t.tier !== "oracle" && statusOf(t) === "shelf").length;

const highlights = [
  { value: String(tinCount), label: "tins on mojoshelf" },
  { value: "3.8 s", label: "1.4B rows in S3, 12 nodes, Dista" },
  { value: "211M", label: "Parquet rows/s, one core" },
  { value: "0", label: "JVM or Python in the path" },
];
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap wrap--wide hero__inner">
    <p class="hero__kicker">magmalake · version 0.x · built in the open</p>

    <h1 class="hero__title">
      Batteries included data framework<br />
      <span class="hero__accent">for Mojo</span>
    </h1>

    <p class="hero__lede">
      Everything a data platform needs, written in Mojo, layer by layer: orchestration
      with Orca and distributed execution with Dista at the top, Iceberg tables and their catalogs, the file
      formats beneath them, object storage and databases, and the primitives and utilities
      everything shares. No Python or JVM in the path. Each tin is independently usable,
      and each is checked against the reference implementation of what it speaks.
    </p>

    <CodeTabs />

    <div class="hero__actions">
      <a class="btn btn--primary" href="/getting-started">Get started</a>
      <a class="btn" href="https://github.com/magmalake" rel="noopener">
        Browse the org on GitHub
      </a>
      <a class="btn" href="/tins">See the tins</a>
    </div>

    <dl class="hero__stats">
      {
        highlights.map((h) => (
          <div class="stat">
            <dt class="stat__value">{h.value}</dt>
            <dd class="stat__label">{h.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero__glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(
        60% 55% at 22% 0%,
        color-mix(in srgb, var(--ember) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        45% 50% at 82% 12%,
        color-mix(in srgb, var(--lake) 14%, transparent),
        transparent 70%
      );
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner { position: relative; z-index: 1; }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 1.4rem;
    display: inline-block;
    border: 1px solid color-mix(in srgb, var(--ember) 32%, transparent);
    background: var(--ember-wash);
    border-radius: 100px;
    padding: 0.35rem 0.9rem;
  }

  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 1.5rem;
  }
  .hero__accent {
    background: linear-gradient(100deg, var(--ember) 8%, var(--lake) 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    font-size: clamp(1.0625rem, 1.9vw, 1.25rem);
    line-height: 1.62;
    color: var(--text-muted);
    max-width: 62ch;
    margin-bottom: 2.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  /* .btn / .btn--primary live in src/styles/sections.css — shared with the
     closing CTA on the home and status pages. */

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .stat { min-width: 0; }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .stat__label {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  @media (max-width: 720px) {
    .hero__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
  }
</style>
