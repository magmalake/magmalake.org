---
/** The home page's hero: what magmalake is, in one line, and where to go. */
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap wrap--wide hero__inner">
    <h1 class="hero__title">
      Data libraries<br />
      <span class="hero__accent">in Mojo</span>
    </h1>

    <p class="hero__lede">
      Parquet, Iceberg, Arrow, Avro, Thrift and the compression codecs, written in Mojo and
      published as tins on mojoshelf. No Python or JVM in the path.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="/tins">See the tins</a>
      <a class="btn" href="/performance">Performance</a>
      <a class="btn" href="https://github.com/magmalake" rel="noopener">
        Browse the org on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero__glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(
        60% 55% at 22% 0%,
        color-mix(in srgb, var(--ember) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        45% 50% at 82% 12%,
        color-mix(in srgb, var(--lake) 14%, transparent),
        transparent 70%
      );
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner { position: relative; z-index: 1; }

  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 1.5rem;
  }
  .hero__accent {
    background: linear-gradient(100deg, var(--ember) 8%, var(--lake) 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    font-size: clamp(1.0625rem, 1.9vw, 1.25rem);
    line-height: 1.62;
    color: var(--text-muted);
    max-width: 62ch;
    margin-bottom: 2.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0;
  }

  /* .btn / .btn--primary live in src/styles/sections.css — shared with the
     closing CTA on the status page. */
</style>
