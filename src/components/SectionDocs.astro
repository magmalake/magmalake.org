---
/**
 * One page of a section's docs, Orca's (/s/orca/docs/...) or Dista's
 * (/s/dista/docs/...): the strip of the section's docs pages atop the page,
 * previous and next links below it, and the docs' styles. The section's
 * header and footer go in the "nav" and "footer" slots (OrcaDocs and
 * DistaDocs fill them); the page's own text is the default slot.
 */
import Base from "../layouts/Base.astro";

export type DocsPage = { href: string; label: string; title: string };

interface Props {
  /** The section's name: "Orca", "Dista". */
  name: string;
  /** The section's docs pages, in reading order. */
  docs: DocsPage[];
  /** This page's href in `docs`. */
  href: string;
  description: string;
}
const { name, docs, href, description } = Astro.props;
const i = docs.findIndex((d) => d.href === href);
if (i < 0) throw new Error(`${href} is not among ${name}'s docs pages`);
const page = docs[i];
const prev = i > 0 ? docs[i - 1] : undefined;
const next = i + 1 < docs.length ? docs[i + 1] : undefined;
---

<Base title={i === 0 ? `Docs · ${name}` : `${page.title} · ${name} docs`} description={description} bare chrome={false}>
  <slot name="nav" />

  <section class="section section--flush">
    <div class="wrap wrap--wide docs section-docs">
      <nav class="section-docs__pages" aria-label={`${name} docs`}>
        {docs.map((d) => (
          <a href={d.href} aria-current={d.href === href ? "page" : undefined}>{d.title}</a>
        ))}
      </nav>
      <slot />
      <nav class="section-docs__pager" aria-label="Previous and next">
        {prev && (
          <a href={prev.href} rel="prev"><span>← Previous</span>{prev.title}</a>
        )}
        {next && (
          <a class="section-docs__next" href={next.href} rel="next"><span>Next →</span>{next.title}</a>
        )}
      </nav>
    </div>
  </section>
  <slot name="footer" />
</Base>

<style is:global>
  .section-docs h2 {
    font-size: 1.35rem;
    margin: 2.75rem 0 0.8rem;
    scroll-margin-top: 5rem;
  }
  .section-docs h3 {
    font-size: 1.05rem;
    margin: 1.8rem 0 0.6rem;
    scroll-margin-top: 5rem;
  }
  .section-docs p,
  .section-docs .table-scroll,
  .section-docs .docs-list {
    max-width: var(--measure);
  }
  .section-docs p + p { margin-top: 0.6rem; }
  .section-docs .table-scroll { margin: 1rem 0 1.1rem; }
  .section-docs table { min-width: 0; }
  .section-docs .docs-list {
    margin: 0.8rem 0 1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }
  .section-docs .docs-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .section-docs__pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.875rem;
  }
  .section-docs__pages a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .section-docs__pages a:hover { color: var(--text); }
  .section-docs__pages a[aria-current="page"] {
    color: var(--text);
    font-weight: 600;
  }
  .section-docs__pager {
    display: flex;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .section-docs__pager a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    font-weight: 600;
  }
  .section-docs__pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-faint);
  }
  .section-docs__next { margin-left: auto; text-align: right; }
</style>
